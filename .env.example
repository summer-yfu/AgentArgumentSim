# Copy to `.env` (gitignored). Do not commit real keys.

# --- ConnectOnion / OpenOnion (model access; often written by `co auth`) ---
# OPENONION_API_KEY=
# AGENT_EMAIL=
# AGENT_ADDRESS=
# AGENT_CONFIG_PATH=

# --- Optional: Chroma / RAG embeddings (must match how you ran build_index) ---
# OPENAI_API_KEY=
# USE_LOCAL_EMBEDDINGS=1

# --- Optional: process logging (Python logging module level name) ---
# LOG_LEVEL=INFO

# --- Factcheck agent (python -m factcheck.server) ---
# For local dev, just point to the server's HTTP endpoint (fast, no relay):
# For remote, use the agent's address instead (connect via P2P relay):
# FACTCHECK_ADDRESS=0x...
# FACTCHECK_MODEL=co/gemini-2.5-pro
# Factcheck host uses BrowserAutomation when Playwright + Chromium are installed (default).
# Disable browser (WebFetch only): FACTCHECK_DISABLE_BROWSER=1
# After pip:  playwright install chromium
