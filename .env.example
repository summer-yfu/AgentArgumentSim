# Copy to `.env` (gitignored). Do not commit real keys.

# --- LLM provider (pick one) ---
# Option 1: ConnectOnion (default, uses co/ model prefix)
# OPENONION_API_KEY=
# AGENT_EMAIL=
# AGENT_ADDRESS=
# AGENT_CONFIG_PATH=

# Option 2: Use your own API keys directly
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- RAG embeddings ---
# USE_LOCAL_EMBEDDINGS=1
# OPENAI_API_KEY=              # only needed if using OpenAI embeddings

# --- Optional ---
# LOG_LEVEL=INFO

# --- Factcheck agent (python -m factcheck.server) ---
# FACTCHECK_ADDRESS=0x...
# FACTCHECK_MODEL=co/gemini-2.5-pro
# FACTCHECK_DISABLE_BROWSER=1  # WebFetch only, no Playwright
